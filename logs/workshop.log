import queue

class Agent:
    def __init__(self, agent_id, agent_type):
        self.agent_id = agent_id
        self.agent_type = agent_type

    def register(self, agents):
        agents[self.agent_id] = self

    def execute_task(self, task):
        print(f"Agent {self.agent_id} executing task {task.task_id}")

class Task:
    def __init__(self, task_id, task_type):
        self.task_id = task_id
        self.task_type = task_type

class MultiAgentSystem:
    def __init__(self):
        self.agents = {}
        self.tasks = queue.Queue()

    def register_agent(self, agent):
        agent.register(self.agents)

    def assign_task(self, task):
        self.tasks.put(task)

    def execute_tasks(self):
        while not self.tasks.empty():
            task = self.tasks.get()
            for agent in self.agents.values():
                if agent.agent_type == task.task_type:
                    agent.execute_task(task)
                    break

agents = {}
system = MultiAgentSystem()

agent1 = Agent("agent1", "type1")
agent2 = Agent("agent2", "type2")

task1 = Task("task1", "type1")
task2 = Task("task2", "type2")

system.register_agent(agent1)
system.register_agent(agent2)

system.assign_task(task1)
system.assign_task(task2)

system.execute_tasks()
