import gradio as gr
from generated_module import Agent, Task, MultiAgentSystem

demo = MultiAgentSystem()

def register_agent(agent_id, agent_type):
    agent = Agent(agent_id, agent_type)
    demo.register_agent(agent)
    return f"Agent {agent_id} registered"

def assign_task(task_id, task_type):
    task = Task(task_id, task_type)
    demo.assign_task(task)
    return f"Task {task_id} assigned"

def execute_tasks():
    demo.execute_tasks()
    return "Tasks executed"

demo_ui = gr.Interface(
    fn=lambda agent_id, agent_type, task_id, task_type: [register_agent(agent_id, agent_type), assign_task(task_id, task_type), execute_tasks()],
    inputs=[
        gr.Textbox(label="Agent ID"),
        gr.Textbox(label="Agent Type"),
        gr.Textbox(label="Task ID"),
        gr.Textbox(label="Task Type")
    ],
    outputs=[
        gr.Textbox(label="Agent Registration"),
        gr.Textbox(label="Task Assignment"),
        gr.Textbox(label="Task Execution")
    ],
    title="Multi-Agent System Demo",
    description="Register agents and assign tasks to them"
)

if __name__ == "__main__":
    demo_ui.launch()
